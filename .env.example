# Public site URL, used for Open Graph image links.
NEXT_PUBLIC_SITE_URL=https://selahlodges.com

# DPO Pay (next task) — server-side only, never expose the company token.
# DPO_COMPANY_TOKEN=
# DPO_SERVICE_TYPE=
# DPO_ENV=sandbox

# Supabase — auth now (database next). Leave blank and the site runs without
# sign-in; set both and redeploy to switch it on. Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails allowed into /admin (or set app_metadata.role =
# "admin" on the user — see README).
ADMIN_EMAILS=
