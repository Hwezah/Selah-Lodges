# Clerk — keys from https://dashboard.clerk.com (copy this file to .env.local)
# Without keys, `npm run dev` runs Clerk in keyless mode; production needs real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Comma-separated emails allowed into /admin (alternative to the Clerk
# public metadata role { "role": "admin" }).
ADMIN_EMAILS=

# Public site URL, used for Open Graph image links.
NEXT_PUBLIC_SITE_URL=https://selahlodges.com

# DPO Pay (next task) — server-side only, never expose the company token.
# DPO_COMPANY_TOKEN=
# DPO_SERVICE_TYPE=
# DPO_ENV=sandbox

# Supabase (planned)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
