# Public site URL, used for Open Graph image links.
NEXT_PUBLIC_SITE_URL=https://selahlodges.com

# DPO Pay (next task) — server-side only, never expose the company token.
# DPO_COMPANY_TOKEN=
# DPO_SERVICE_TYPE=
# DPO_ENV=sandbox

# Clerk auth — optional. Leave blank and the site runs without sign-in; add
# both keys (dashboard.clerk.com → API Keys) and redeploy to switch it on.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated emails allowed into /admin (or give a user the Clerk public
# metadata { "role": "admin" }).
ADMIN_EMAILS=

# Supabase (planned)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
